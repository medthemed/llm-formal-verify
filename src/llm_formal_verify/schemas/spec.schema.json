{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medthemed.github.io/llm-formal-verify/schemas/spec.schema.json",
  "title": "lfv spec document",
  "description": "Serialized IR for a business-logic specification loaded by lfv check / lfv tla.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "variables", "init", "actions", "invariants", "checks"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "domain"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "domain": {
            "type": "array",
            "minItems": 1,
            "items": { "type": ["boolean", "integer", "string"] }
          },
          "comment": { "type": "string" }
        }
      }
    },
    "init": { "$ref": "#/$defs/expr" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "invariants": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "expr": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["lit", "var", "unary", "binop"]
        },
        "value": {},
        "name": { "type": "string" },
        "op": { "type": "string" },
        "operand": { "$ref": "#/$defs/expr" },
        "left": { "$ref": "#/$defs/expr" },
        "right": { "$ref": "#/$defs/expr" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "expr"],
      "properties": {
        "target": { "type": "string" },
        "expr": { "$ref": "#/$defs/expr" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "guard", "assignments"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "guard": { "$ref": "#/$defs/expr" },
        "assignments": {
          "type": "array",
          "items": { "$ref": "#/$defs/assignment" }
        },
        "comment": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "expr"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["safety", "liveness"] },
        "expr": { "$ref": "#/$defs/expr" },
        "comment": { "type": "string" }
      }
    }
  }
}
